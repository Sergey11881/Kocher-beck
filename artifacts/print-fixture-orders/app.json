{
  "expo": {
    "name": "Kocher+Beck Smart Order",
    "slug": "kocher-beck-smart-order",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/company-logo-icon.png",
    "scheme": "kocher-beck-smart-order",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/company-logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.sergeypavlov.kocherbecksmartorder",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {},
    "web": {
      "favicon": "./assets/images/company-logo.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://replit.com/"
        }
      ],
      "expo-font",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "f60be0bd-39b8-4c9f-ae98-d65e53ba924e"
      }
    }
  }
}
